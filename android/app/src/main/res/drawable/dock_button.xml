<?xml version="1.0" encoding="utf-8"?>
<!-- The open page's button is lit in the accent; a press shows as the
     Linux dock's hover does. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/bar_button" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
