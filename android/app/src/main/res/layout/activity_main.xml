<?xml version="1.0" encoding="utf-8"?>
<!-- The Stitches window, as on Linux: the open page, and a dock of icons
     centred under it. The logo is Home; then Uninstall; then theme and
     optional access, a divider between each part. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_home"
            layout="@layout/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page_uninstall"
            layout="@layout/page_uninstall"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/dock"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/dock_home"
            style="@style/DockButton"
            android:contentDescription="@string/home"
            android:padding="5dp"
            android:src="@drawable/logo"
            android:tint="@null" />

        <View style="@style/DockSeparator" />

        <ImageButton
            android:id="@+id/dock_uninstall"
            style="@style/DockButton"
            android:contentDescription="@string/uninstall"
            android:src="@drawable/ic_uninstall" />

        <View style="@style/DockSeparator" />

        <ImageButton
            android:id="@+id/dock_theme"
            style="@style/DockButton"
            android:contentDescription="@string/theme"
            android:src="@drawable/ic_theme" />

        <ImageButton
            android:id="@+id/dock_access"
            style="@style/DockButton"
            android:contentDescription="@string/access"
            android:src="@drawable/ic_access" />
    </LinearLayout>
</LinearLayout>
