<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Platform Material, not the AndroidX Material Components library: the
         app pulls in no UI dependency at all. See ai-knowledgebase.md. The
         four are the Linux build's; the dock and the action bar stay dark in
         Light and Dark, as they do there by default. -->
    <style name="Theme.Stitches.Dark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorAccent">@color/line</item>
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:statusBarColor">@color/window_dark</item>
        <item name="android:navigationBarColor">@color/window_dark</item>
        <item name="cardColor">#202128</item>
        <item name="cardBorder">#14FFFFFF</item>
        <item name="dockColor">#111217</item>
        <item name="dockBorder">#00000000</item>
    </style>

    <style name="Theme.Stitches.AMOLED" parent="Theme.Stitches.Dark">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="cardColor">#070707</item>
        <item name="cardBorder">#1B1B1B</item>
        <item name="dockColor">#0A0A0A</item>
        <item name="dockBorder">#1C1C1C</item>
    </style>

    <!-- The wallpaper shows through, which is what Glass is on Linux too
         (translucency, no blur). -->
    <style name="Theme.Stitches.Glass" parent="Theme.Stitches.Dark">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@color/window_glass</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="cardColor">#12FFFFFF</item>
        <item name="cardBorder">#24FFFFFF</item>
        <item name="dockColor">#B308090E</item>
        <item name="dockBorder">#24FFFFFF</item>
    </style>

    <style name="Theme.Stitches.Light" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:statusBarColor">@color/window_light</item>
        <item name="android:navigationBarColor">@color/window_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="cardColor">#FFFFFF</item>
        <item name="cardBorder">#1A000000</item>
        <item name="dockColor">#111217</item>
        <item name="dockBorder">#00000000</item>
    </style>

    <color name="window_dark">#17181D</color>
    <color name="window_light">#F4F5F8</color>
    <color name="window_glass">#BF161824</color>
</resources>
