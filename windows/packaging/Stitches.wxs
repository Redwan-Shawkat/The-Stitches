<?xml version="1.0" encoding="UTF-8"?>
<!--
  One executable, one shortcut, one Apps & Features entry. Deliberately not a
  multi-feature installer with a directory-chooser UI: there is one file to
  place, so the extra dialogs would be pages of WiX asking questions with one
  sensible answer. Built by ..\build-msi.ps1, which supplies Version,
  ExeSource and IconSource.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Stitches"
      Manufacturer="Redwan Shawkat"
      Version="$(var.Version)"
      UpgradeCode="{1ABBD8C4-5327-4223-A0DB-3F92A3932AFD}"
      Scope="perMachine"
      Compressed="yes">

    <!-- Installing a newer build replaces the older one in place instead of
         leaving two entries behind. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Stitches is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The Id is the file name Windows Installer extracts the icon to, and
         the shortcut and Apps & Features point at it. Without ".ico",
         Explorer can't read it and the Start Menu shows a blank icon. -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Redwan-Shawkat/The-Uninstaller" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Stitches" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Stitches" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents">
      <!-- A new GUID for the 0.2 rename: the file and folder names changed, and a
         component keeps one key path for life. The UpgradeCode above is what
         makes this package replace an installed "The Uninstaller". -->
      <Component Directory="INSTALLFOLDER" Guid="{2414B306-DB87-497F-91D8-6BE4767333C8}">
        <File Id="MainExecutable" Source="$(var.ExeSource)" KeyPath="yes">
          <!-- Nested in the File so the shortcut needs no component and no
               registry key of its own to be its KeyPath. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Stitches"
                    Description="Find and remove software regardless of how it was installed"
                    Icon="AppIcon.ico"
                    Advertise="yes" />
        </File>
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
